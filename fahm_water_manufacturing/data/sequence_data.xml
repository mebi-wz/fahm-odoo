<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_fahm_water_qc_check" model="ir.sequence">
        <field name="name">Water QC Check</field>
        <field name="code">fahm.water.qc.check</field>
        <field name="prefix">WQC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_fahm_material_request" model="ir.sequence">
        <field name="name">Production Material Request</field>
        <field name="code">fahm.material.request</field>
        <field name="prefix">WMR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_fahm_water_treatment" model="ir.sequence">
        <field name="name">Water Treatment Batch</field>
        <field name="code">fahm.water.treatment</field>
        <field name="prefix">WTB/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_fahm_fg_handover" model="ir.sequence">
        <field name="name">Finished Goods Handover</field>
        <field name="code">fahm.fg.handover</field>
        <field name="prefix">WFH/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
