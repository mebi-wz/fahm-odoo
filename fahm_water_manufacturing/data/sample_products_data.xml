    <record id="categ_water" model="product.category">
        <field name="name">Water Plant</field>
    </record>
    <record id="categ_water_raw" model="product.category">
        <field name="name">Raw Materials</field>
        <field name="parent_id" ref="categ_water"/>
    </record>
    <record id="categ_water_pack" model="product.category">
        <field name="name">Packaging</field>
        <field name="parent_id" ref="categ_water"/>
    </record>
    <record id="categ_water_fg" model="product.category">
        <field name="name">Finished Goods</field>
        <field name="parent_id" ref="categ_water"/>
    </record>

