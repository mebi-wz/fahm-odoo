<?xml version="1.0" encoding="utf-8"?>
<!--
    Sample Fahm water products, bills of materials, lines and water source.
    Loaded on module install/upgrade. noupdate="1": once created, later upgrades do not
    overwrite your changes (names, quantities, prices), and deleted records are not recreated.
    Quantities are starting points: adjust them to your supplier specifications.
-->
<odoo noupdate="1">

