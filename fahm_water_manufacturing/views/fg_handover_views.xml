<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fahm_fg_handover_list" model="ir.ui.view">
        <field name="name">fahm.fg.handover.list</field>
        <field name="model">fahm.fg.handover</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="date"/>
                <field name="production_id"/>
                <field name="handed_over_by_id" widget="many2one_avatar_user"/>
                <field name="received_by_id" widget="many2one_avatar_user" optional="show"/>
                <field name="date_received" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'received'"/>
            </list>
        </field>
    </record>

    <record id="view_fahm_fg_handover_form" model="ir.ui.view">
        <field name="name">fahm.fg.handover.form</field>
        <field name="model">fahm.fg.handover</field>
        <field name="arch" type="xml">
            <form string="Finished Goods Handover">
                <header>
                    <button name="action_submit" type="object" string="Submit to Store" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_view_pickings" type="object" string="Receive in Store" class="oe_highlight"
                            invisible="state != 'submitted'" groups="stock.group_stock_user"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('received', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,received"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings" type="object" class="oe_stat_button" icon="fa-truck"
                                invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="Transfers"/>
                        </button>
                    </div>
                    <div class="alert alert-info mb-3" role="alert" invisible="state != 'submitted'">
                        Waiting for the store: open the transfer and <b>Validate</b> it once the goods are received.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="production_id" readonly="1"/>
                            <field name="warehouse_id" readonly="1" groups="stock.group_stock_multi_warehouses"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="handed_over_by_id" widget="many2one_avatar_user" readonly="state != 'draft'"/>
                            <field name="received_by_id" widget="many2one_avatar_user" invisible="not received_by_id"/>
                            <field name="date_received" invisible="not date_received"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Finished Goods" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="lot_id"/>
                                    <field name="expiration_date"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fahm_fg_handover_search" model="ir.ui.view">
        <field name="name">fahm.fg.handover.search</field>
        <field name="model">fahm.fg.handover</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="production_id"/>
                <filter string="To Receive" name="to_receive" domain="[('state', '=', 'submitted')]"/>
                <filter string="Received" name="received" domain="[('state', '=', 'received')]"/>
                <filter string="Date" name="filter_date" date="date"/>
            </search>
        </field>
    </record>

    <record id="action_fahm_fg_handover" model="ir.actions.act_window">
        <field name="name">Finished Goods Handovers</field>
        <field name="res_model">fahm.fg.handover</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No handovers yet</p>
            <p>After a water production order is produced, click <b>Hand Over to Store</b> on it.</p>
        </field>
    </record>

    <record id="action_fahm_fg_handover_to_receive" model="ir.actions.act_window">
        <field name="name">Finished Goods to Receive</field>
        <field name="res_model">fahm.fg.handover</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'search_default_to_receive': 1}</field>
    </record>
</odoo>
