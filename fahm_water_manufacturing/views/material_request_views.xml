<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fahm_material_request_list" model="ir.ui.view">
        <field name="name">fahm.material.request.list</field>
        <field name="model">fahm.material.request</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('cancel', 'rejected')">
                <field name="name"/>
                <field name="date"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="requested_by_id" widget="many2one_avatar_user"/>
                <field name="approved_by_id" widget="many2one_avatar_user" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('submitted', 'approved', 'issuing')"
                       decoration-success="state == 'issued'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_fahm_material_request_form" model="ir.ui.view">
        <field name="name">fahm.material.request.form</field>
        <field name="model">fahm.material.request</field>
        <field name="arch" type="xml">
            <form string="Material Request">
                <header>
                    <button name="action_submit" type="object" string="Submit for Approval" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight"
                            invisible="state != 'submitted'" groups="mrp.group_mrp_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('submitted', 'approved')" groups="mrp.group_mrp_manager"
                            confirm="Reject this material request?"/>
                    <button name="action_issue" type="object" string="Issue Materials" class="oe_highlight"
                            invisible="state != 'approved'" groups="stock.group_stock_user"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'submitted', 'approved', 'rejected')"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('rejected', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,issuing,issued"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings" type="object" class="oe_stat_button" icon="fa-truck"
                                invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="Transfers"/>
                        </button>
                    </div>
                    <div class="alert alert-info mb-3" role="alert" invisible="state != 'issuing'">
                        The store has prepared the transfer. Validate it once the materials are physically
                        handed over to production.
                    </div>
                    <div class="alert alert-danger mb-3" role="alert" invisible="state != 'rejected'">
                        Rejected. <field name="reject_reason" nolabel="1" class="d-inline"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="production_id" readonly="1"/>
                            <field name="product_id"/>
                            <field name="warehouse_id" groups="stock.group_stock_multi_warehouses"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="requested_by_id" widget="many2one_avatar_user" readonly="state != 'draft'"/>
                            <field name="approved_by_id" widget="many2one_avatar_user" invisible="not approved_by_id"/>
                            <field name="date_approved" invisible="not date_approved"/>
                            <field name="issued_by_id" widget="many2one_avatar_user" invisible="not issued_by_id"/>
                            <field name="date_issued" invisible="not date_issued"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Materials" name="materials">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" decoration-danger="is_short and parent.state in ('submitted', 'approved')">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="fahm_water_type" optional="show"/>
                                    <field name="qty_required"/>
                                    <field name="qty_requested"/>
                                    <field name="uom_id" groups="uom.group_uom"/>
                                    <field name="qty_available"/>
                                    <field name="qty_issued"/>
                                    <field name="is_short" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Remarks for the approver or the store..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fahm_material_request_search" model="ir.ui.view">
        <field name="name">fahm.material.request.search</field>
        <field name="model">fahm.material.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <filter string="To Approve" name="to_approve" domain="[('state', '=', 'submitted')]"/>
                <filter string="To Issue" name="to_issue" domain="[('state', 'in', ('approved', 'issuing'))]"/>
                <filter string="Issued" name="issued" domain="[('state', '=', 'issued')]"/>
                <separator/>
                <filter string="My Requests" name="my_requests" domain="[('requested_by_id', '=', uid)]"/>
                <filter string="Date" name="filter_date" date="date"/>
                <group>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Requested By" name="groupby_requester" context="{'group_by': 'requested_by_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fahm_material_request" model="ir.actions.act_window">
        <field name="name">Material Requests</field>
        <field name="res_model">fahm.material.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No material requests yet</p>
            <p>Open a confirmed water production order and click <b>Request Materials</b>.</p>
        </field>
    </record>

    <record id="action_fahm_material_request_to_approve" model="ir.actions.act_window">
        <field name="name">Requests to Approve</field>
        <field name="res_model">fahm.material.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'search_default_to_approve': 1}</field>
    </record>

    <record id="action_fahm_material_request_to_issue" model="ir.actions.act_window">
        <field name="name">Materials to Issue</field>
        <field name="res_model">fahm.material.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'search_default_to_issue': 1}</field>
    </record>
</odoo>
