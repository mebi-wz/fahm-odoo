<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fahm_water_source_list" model="ir.ui.view">
        <field name="name">fahm.water.source.list</field>
        <field name="model">fahm.water.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="source_type"/>
                <field name="location"/>
                <field name="licence_number" optional="show"/>
                <field name="licence_expiry" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fahm_water_source_form" model="ir.ui.view">
        <field name="name">fahm.water.source.form</field>
        <field name="model">fahm.water.source</field>
        <field name="arch" type="xml">
            <form string="Water Source">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_qc_checks" type="object" class="oe_stat_button" icon="fa-flask">
                            <field name="qc_check_count" widget="statinfo" string="QC Checks"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Borehole No. 1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="source_type"/>
                            <field name="location"/>
                            <field name="depth_m" invisible="source_type != 'borehole'"/>
                        </group>
                        <group>
                            <field name="licence_number"/>
                            <field name="licence_expiry"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fahm_water_source" model="ir.actions.act_window">
        <field name="name">Water Sources</field>
        <field name="res_model">fahm.water.source</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a water source</p>
            <p>Boreholes, springs or municipal supply feeding the treatment plant.</p>
        </field>
    </record>
</odoo>
