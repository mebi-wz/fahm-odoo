<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fahm_production_stage_list" model="ir.ui.view">
        <field name="name">fahm.production.stage.list</field>
        <field name="model">fahm.production.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="line_type"/>
                <field name="name"/>
                <field name="unit_label"/>
                <field name="is_final"/>
                <field name="description" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_fahm_production_stage_search" model="ir.ui.view">
        <field name="name">fahm.production.stage.search</field>
        <field name="model">fahm.production.stage</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <group>
                    <filter string="Line Type" name="groupby_line_type" context="{'group_by': 'line_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fahm_production_stage" model="ir.actions.act_window">
        <field name="name">Production Stages</field>
        <field name="res_model">fahm.production.stage</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_groupby_line_type': 1, 'active_test': False}</field>
    </record>
</odoo>
