<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fahm_production_shift_list" model="ir.ui.view">
        <field name="name">fahm.production.shift.list</field>
        <field name="model">fahm.production.shift</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="hour_from" widget="float_time"/>
                <field name="hour_to" widget="float_time"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_fahm_production_shift" model="ir.actions.act_window">
        <field name="name">Shifts</field>
        <field name="res_model">fahm.production.shift</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
