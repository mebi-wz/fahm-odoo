<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_fahm_water" model="ir.ui.view">
        <field name="name">product.template.form.fahm.water</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Water Plant" name="fahm_water">
                    <group>
                        <group string="Classification">
                            <field name="fahm_water_type"/>
                            <field name="fahm_qc_required" invisible="not fahm_water_type"/>
                        </group>
                        <group string="Content" invisible="fahm_water_type not in ('finished_water', 'treated_water', 'jar')">
                            <field name="fahm_volume_per_unit"/>
                            <field name="fahm_units_per_pack"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_fahm_water" model="ir.ui.view">
        <field name="name">product.template.search.fahm.water</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Finished Water" name="fahm_finished_water"
                        domain="[('fahm_water_type', '=', 'finished_water')]"/>
                <filter string="Water Packaging Materials" name="fahm_packaging"
                        domain="[('fahm_water_type', 'in', ('preform', 'bottle', 'cap', 'label', 'shrink_film', 'carton', 'jar'))]"/>
                <group>
                    <filter string="Water Plant Type" name="groupby_fahm_water_type" context="{'group_by': 'fahm_water_type'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_fahm_water_products" model="ir.actions.act_window">
        <field name="name">Water Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('fahm_water_type', '!=', False)]</field>
        <field name="context">{'default_fahm_water_type': 'finished_water', 'default_fahm_qc_required': True, 'default_is_storable': True, 'search_default_groupby_fahm_water_type': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first water product</p>
            <p>Classify finished water, preforms, caps, labels and other materials used by the plant.</p>
        </field>
    </record>
</odoo>
