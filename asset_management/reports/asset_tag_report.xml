<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_asset_tag_template">
        <t t-call="web.basic_layout">
            <t t-call="web.html_container">
                <style>
                    .asset-tag-sheet {
                        width: 210mm;
                        min-height: 297mm;
                        padding: 8mm 7mm;
                        box-sizing: border-box;
                        page-break-after: always;
                    }
                    .asset-tag-sheet:last-child {
                        page-break-after: auto;
                    }
                    .asset-tag-table {
                        width: 100%;
                        table-layout: fixed;
                        border-collapse: separate;
                        border-spacing: 3mm 1mm;
                    }
                    .asset-tag-cell {
                        width: 50%;
                        height: 26mm;
                        padding: 0;
                        vertical-align: middle;
                    }
                    .asset-tag-card {
                        width: 100%;
                        height: 25mm;
                        border: 1.5px solid #263746;
                        border-radius: 3mm;
                        background: #ffffff;
                        box-sizing: border-box;
                        display: table;
                        page-break-inside: avoid;
                    }
                    .asset-tag-card-inner {
                        display: table-cell;
                        padding: 1.5mm 3mm;
                        text-align: center;
                        vertical-align: middle;
                    }
                    .asset-tag-number {
                        color: #16232e;
                        font-family: 'DejaVu Sans Mono', 'Courier New', monospace;
                        font-size: 18pt;
                        font-weight: 800;
                        letter-spacing: 1px;
                        line-height: 1.15;
                        overflow-wrap: anywhere;
                    }
                </style>

                <t t-set="nRows" t-value="10"/>
                <t t-set="nCols" t-value="2"/>
                <t t-foreach="[docs[offset:offset + nRows * nCols] for offset in range(0, len(docs), nRows * nCols)]" t-as="page_docs">
                    <div class="page asset-tag-sheet">
                        <table class="asset-tag-table">
                            <tbody>
                                <t t-foreach="range(nRows)" t-as="row">
                                    <tr>
                                        <t t-foreach="range(nCols)" t-as="column">
                                            <t t-set="asset_index" t-value="row * nCols + column"/>
                                            <td class="asset-tag-cell">
                                                <t t-if="asset_index &lt; len(page_docs)">
                                                    <t t-set="doc" t-value="page_docs[asset_index]"/>
                                                    <div class="asset-tag-card">
                                                        <div class="asset-tag-card-inner">
                                                            <div class="asset-tag-number">
                                                                <t t-esc="doc.tag_number or ''"/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </t>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="paperformat_asset_tag_a4" model="report.paperformat">
        <field name="name">Asset Tags A4 (2 x 10)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_asset_tag" model="ir.actions.report">
        <field name="name">Asset Tags (Print Tag)</field>
        <field name="model">am.asset</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">asset_management.report_asset_tag_template</field>
        <field name="report_file">asset_management.report_asset_tag_template</field>
        <field name="paperformat_id" ref="asset_management.paperformat_asset_tag_a4"/>
        <field name="print_report_name">('Asset_Tag_%s' % (object.tag_number or object.name or 'Tag')).replace(' ', '_') if object else 'Asset_Tags'</field>
        <field name="binding_model_id" ref="model_am_asset"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
